DATABASE_URL="postgresql://slm_user:slm_password@localhost:5432/slm_db?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
PORT=4000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=10

# Optional: powers the admin dashboard's "Saytdan foydalanish statistikasi"
# section via Cloudflare's GraphQL Analytics API. Leave unset to disable it.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Kirish nomi domeni: "axror" -> "axror@slm.uz". Haqiqiy pochta emas.
LOGIN_EMAIL_DOMAIN=slm.uz

# OnlyOffice (SMK forma shablonlarini onlayn ochish/tahrirlash). Kamida 32 belgi;
# backend va onlyoffice konteyneri bir xil qiymatdan foydalanadi. Bo'sh bo'lsa — o'chiq.
ONLYOFFICE_JWT_SECRET=
# Ixtiyoriy (standart qiymatlar docker-compose uchun):
# ONLYOFFICE_PUBLIC_PATH=/onlyoffice
# ONLYOFFICE_INTERNAL_URL=http://onlyoffice
# BACKEND_INTERNAL_URL=http://backend:4000
