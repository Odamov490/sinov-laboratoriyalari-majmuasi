DATABASE_URL="postgresql://slm_user:slm_password@localhost:5432/slm_db?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
PORT=4000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=10

# Optional: powers the admin dashboard's "Saytdan foydalanish statistikasi"
# section via Cloudflare's GraphQL Analytics API. Leave unset to disable it.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Kirish nomi domeni: "axror" -> "axror@slm.uz". Haqiqiy pochta emas.
LOGIN_EMAIL_DOMAIN=slm.uz

# Tris integratsiyasi (OAuth 2.0 Authorization Code + PKCE). Bo'sh bo'lsa
# integratsiya "sozlanmagan" holatida, ilovaning qolgan qismi ishlayveradi.
# Haqiqiy qiymatlarni faqat serverdagi .env'ga yozing (GitHub'ga emas).
TRIS_API_BASE_URL=
TRIS_OAUTH_AUTHORIZE_URL=
TRIS_OAUTH_TOKEN_URL=
TRIS_OAUTH_REVOKE_URL=
TRIS_OAUTH_USERINFO_URL=
TRIS_OAUTH_CLIENT_ID=
TRIS_OAUTH_CLIENT_SECRET=
# client_secret_basic | client_secret_post | none
TRIS_OAUTH_TOKEN_AUTH_METHOD=
# Bo'sh joy bilan ajratilgan
TRIS_OAUTH_SCOPES=
TRIS_OAUTH_REDIRECT_URI=
TRIS_OAUTH_PKCE=
# 32 bayt, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TRIS_TOKEN_ENCRYPTION_KEY=
TRIS_API_PING_PATH=
# Faqat ishlab chiqish: soxta provayder (production'da e'tiborsiz qoldiriladi)
TRIS_OAUTH_MOCK=
