generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  MANAGER
  EDITOR
  // Xodim: faqat vazifalar, bildirishnomalar va o'z profili.
  STAFF
}

enum ApplicationStatus {
  QABUL_QILINDI
  KORIB_CHIQILMOQDA
  SINOV_JARAYONIDA
  NATIJA_TAYYOR
  YAKUNLANDI
  BEKOR_QILINDI
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  labId        String?
  lab          Laboratory? @relation(fields: [labId], references: [id])
  isActive     Boolean  @default(true)
  // Mutaxassis (Staff) kartasiga bog'langan hisob; login = email.
  staffId            String?   @unique
  staff              Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  // Chat: SUPER_ADMIN shaxsan o'chirib qo'yishi mumkin; lastSeenAt — oxirgi socket uzilishi.
  chatEnabled        Boolean   @default(true)
  lastSeenAt         DateTime?
  // Shaxsiy kabinet: rasm, kontaktlar, sozlamalar (faqat egasi o'zgartiradi).
  avatarUrl          String?
  phone              String?
  telegram           String?
  preferences        Json      @default("{}")
  passwordChangedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
  sampleMovements SampleMovement[]
  testItemsAdded  ApplicationTestItem[]
  testJournalChanges               TestJournalChange[]
  tasksCreated                     Task[]             @relation("TaskCreator")
  taskAssignments                  TaskAssignee[]
  taskComments                     TaskComment[]
  taskAttachments                  TaskAttachment[]
  taskActivities                   TaskActivity[]
  notifications                    Notification[]
  chatRoomsCreated                 ChatRoom[]          @relation("ChatRoomCreator")
  chatMemberships                  ChatMember[]
  chatMessages                     ChatMessage[]
  chatAttachments                  ChatAttachment[]
  chatReactions                    ChatReaction[]
  chatPins                         ChatPinned[]
  chatHidden                       ChatMessageHidden[]
  stickerPacksCreated              StickerPack[]
  loginEvents                      LoginEvent[]
  sessions                         UserSession[]
  smkFormEntriesCreated            SmkFormEntry[]
}

model Laboratory {
  id                  String   @id @default(uuid())
  slug                String   @unique
  nameUz              String
  nameRu              String
  nameEn              String
  descriptionUz       String?
  descriptionRu       String?
  descriptionEn       String?
  aboutUz             String?
  aboutRu             String?
  aboutEn             String?
  accreditationScope  String?
  coverImage          String?
  order               Int      @default(0)
  isActive            Boolean  @default(true)
  services            Service[]
  equipment           Equipment[]
  staff               Staff[]
  standards           Standard[]
  gallery             Gallery[]
  samplesOrigin       Sample[] @relation("SampleOrigin")
  samplesCurrent      Sample[] @relation("SampleCurrent")
  movementsFrom       SampleMovement[] @relation("MovementFrom")
  movementsTo         SampleMovement[] @relation("MovementTo")
  users               User[]
  testIndicators      TestIndicator[]
  products            Product[]
  tasks                   Task[]
  chatRoom                ChatRoom?
  // SMK: laboratoriya tanlagan formalar va ularning yozuvlari.
  smkForms            SmkLabForm[]
  smkFormEntries      SmkFormEntry[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?
}

model ServiceCategory {
  id        String    @id @default(uuid())
  nameUz    String
  nameRu    String
  nameEn    String
  services  Service[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Service {
  id              String   @id @default(uuid())
  slug            String   @unique
  nameUz          String
  nameRu          String
  nameEn          String
  descriptionUz   String?
  descriptionRu   String?
  descriptionEn   String?
  testObject      String?
  testType        String?
  durationDays    Int?
  laboratoryId    String
  laboratory      Laboratory @relation(fields: [laboratoryId], references: [id])
  categoryId      String?
  category        ServiceCategory? @relation(fields: [categoryId], references: [id])
  standardId      String?
  standard        Standard? @relation(fields: [standardId], references: [id])
  prices          Price[]
  applications    Application[]
  testItems       ApplicationTestItem[]
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
}

model Price {
  id            String   @id @default(uuid())
  serviceId     String
  service       Service  @relation(fields: [serviceId], references: [id])
  amount        Decimal? @db.Decimal(14, 2)
  currency      String   @default("UZS")
  effectiveFrom DateTime @default(now())
  isCurrent     Boolean  @default(true)
  history       PriceHistory[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PriceHistory {
  id            String   @id @default(uuid())
  priceId       String
  price         Price    @relation(fields: [priceId], references: [id])
  amount        Decimal? @db.Decimal(14, 2)
  currency      String   @default("UZS")
  changedAt     DateTime @default(now())
}

model Standard {
  id            String   @id @default(uuid())
  code          String   @unique
  nameUz        String
  nameRu        String
  nameEn        String
  category      String
  scopeUz       String?
  scopeRu       String?
  scopeEn       String?
  documentUrl   String?
  laboratoryId  String?
  laboratory    Laboratory? @relation(fields: [laboratoryId], references: [id])
  services      Service[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
}

model NewsCategory {
  id      String @id @default(uuid())
  nameUz  String
  nameRu  String
  nameEn  String
  news    News[]
}

model News {
  id              String   @id @default(uuid())
  slug            String   @unique
  titleUz         String
  titleRu         String
  titleEn         String
  descriptionUz   String?
  descriptionRu   String?
  descriptionEn   String?
  contentUz       String?
  contentRu       String?
  contentEn       String?
  image           String?
  categoryId      String?
  category        NewsCategory? @relation(fields: [categoryId], references: [id])
  seoTitle        String?
  seoDescription  String?
  isPublished     Boolean  @default(false)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
}

model DocumentCategory {
  id        String     @id @default(uuid())
  nameUz    String
  nameRu    String
  nameEn    String
  documents Document[]
}

model Document {
  id          String   @id @default(uuid())
  titleUz     String
  titleRu     String
  titleEn     String
  fileUrl     String
  categoryId  String?
  category    DocumentCategory? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model Staff {
  id              String   @id @default(uuid())
  fullName        String
  position        String
  specialization  String?
  experienceYears Int?
  email           String?
  phone           String?
  photo           String?
  laboratoryId    String?
  laboratory      Laboratory? @relation(fields: [laboratoryId], references: [id])
  order           Int      @default(0)
  // Internal HR fields -- admin-only, never returned by the public API
  // (see getStaff's explicit `select` in publicController.js).
  staffNumber     Int?
  employeeCode    String?
  hireDate        DateTime?
  birthDate       DateTime?
  passportSeries  String?
  passportNumber  String?
  pinfl           String?
  address         String?
  notes           String?
  // Nofaol mutaxassisning bog'langan hisobi ham nofaol qilinadi.
  isActive        Boolean  @default(true)
  account         User?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
}

model Equipment {
  id             String   @id @default(uuid())
  slug           String   @unique
  name           String
  manufacturer   String?
  model          String?
  specifications String?
  application    String?
  photo          String?
  laboratoryId   String?
  laboratory     Laboratory? @relation(fields: [laboratoryId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
}

model GalleryCategory {
  id      String    @id @default(uuid())
  nameUz  String
  nameRu  String
  nameEn  String
  items   Gallery[]
}

model Gallery {
  id           String   @id @default(uuid())
  title        String?
  imageUrl     String
  categoryId   String?
  category     GalleryCategory? @relation(fields: [categoryId], references: [id])
  laboratoryId String?
  laboratory   Laboratory? @relation(fields: [laboratoryId], references: [id])
  createdAt    DateTime @default(now())
}

model FAQ {
  id          String   @id @default(uuid())
  questionUz  String
  questionRu  String
  questionEn  String
  answerUz    String
  answerRu    String
  answerEn    String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Application {
  id                String   @id @default(uuid())
  applicationNumber String   @unique
  fullName          String
  organization      String?
  phone             String
  email             String?
  productName       String
  productType       String?
  laboratoryId      String?
  serviceId         String?
  service           Service? @relation(fields: [serviceId], references: [id])
  tnVedCode         String?
  productDescription String?
  testType          String?
  comment           String?
  tnVedWarningShown    Boolean @default(false)
  tnVedWarningCategory String?
  status            ApplicationStatus @default(QABUL_QILINDI)
  statusComment     String?
  samples         Sample[]
  files             ApplicationFile[]
  testItems         ApplicationTestItem[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ApplicationTestItem {
  id            String       @id @default(uuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id])
  serviceId     String
  service       Service      @relation(fields: [serviceId], references: [id])
  addedByUserId String?
  addedByUser   User?        @relation(fields: [addedByUserId], references: [id])
  createdAt     DateTime     @default(now())
}

model ApplicationFile {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  fileUrl       String
  originalName  String
  mimeType      String
  size          Int
  createdAt     DateTime    @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  fullName  String
  phone     String?
  email     String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Accreditation {
  id                String   @id @default(uuid())
  certificateNumber String
  standardCode      String
  scopeUz           String?
  scopeRu           String?
  scopeEn           String?
  documentUrl       String?
  // Link to the official accreditation-scope document on the national
  // akkred.uz system — kept as a plain admin-editable URL (not an uploaded
  // file) since the scope there changes often and this just needs to point
  // at whatever the current one is.
  scopeUrl          String?
  issuedAt          DateTime?
  validUntil        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SiteSetting {
  id            String   @id @default(uuid())
  key           String   @unique
  value         String?
  updatedAt     DateTime @updatedAt
}

enum SampleStatus {
  LABORATORIYADA
  TASHILMOQDA
  YAKUNLANDI
}

enum MovementAction {
  REGISTRATSIYA
  CHIQARISH
  QABUL_QILISH
  YAKUNLASH
}

model Sample {
  id            String       @id @default(uuid())
  code          String       @unique
  productName   String
  description   String?
  originLabId   String
  originLab     Laboratory   @relation("SampleOrigin", fields: [originLabId], references: [id])
  currentLabId  String?
  currentLab    Laboratory?  @relation("SampleCurrent", fields: [currentLabId], references: [id])
  status        SampleStatus @default(LABORATORIYADA)
  dueDate       DateTime?
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  photoUrl      String?
  reportUrl     String?
  movements     SampleMovement[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
}

model SampleMovement {
  id                String         @id @default(uuid())
  sampleId          String
  sample            Sample         @relation(fields: [sampleId], references: [id])
  fromLabId         String?
  fromLab           Laboratory?    @relation("MovementFrom", fields: [fromLabId], references: [id])
  toLabId           String?
  toLab             Laboratory?    @relation("MovementTo", fields: [toLabId], references: [id])
  action            MovementAction
  performedByUserId String?
  performedByUser   User?          @relation(fields: [performedByUserId], references: [id])
  performedByName   String?
  notes             String?
  createdAt         DateTime       @default(now())
}

enum TnVedRegulationCategory {
  SERTIFIKAT
  DEKLARATSIYA
}

// Reference table for mandatory conformity requirements (Cabinet of Ministers
// resolution 43): which HS/TN VED code ranges require a mandatory
// certificate vs. a declaration of conformity. tnVedRaw keeps the original
// legal-text range/exception wording verbatim (see parseTnVedRanges — it is
// only approximately machine-parseable at the 4-digit heading level).
model TnVedRegulation {
  id        String                  @id @default(uuid())
  item      String
  nameUz    String
  tnVedRaw  String
  category  TnVedRegulationCategory
  decision  String
  createdAt DateTime                @default(now())
}

// Reference data from Cabinet of Ministers resolution No. 733 (2022-12-31,
// Annex 1): TIF TN (HS) code version lookup, unrelated to the
// certificate/declaration requirement above. Two tables:
//  - TnVedCurrentCode: codes confirmed to exist under the 2022 revision.
//  - TnVedCodeConversion: old (2017) codes that were renumbered/split, with
//    their 2022 successor code(s).
// A code not present in EITHER table is not claimed to "not exist" — this
// source only lists codes that changed, so an unlisted code is treated as
// unchanged between the 2017 and 2022 revisions.
model TnVedCurrentCode {
  id        String   @id @default(uuid())
  digits    String   @unique
  display   String
  nameUz    String?
  createdAt DateTime @default(now())
}

model TnVedCodeConversion {
  id         String   @id @default(uuid())
  oldDigits  String   @unique
  oldDisplay String
  newCodes   Json
  createdAt  DateTime @default(now())
}

// Admin-editable public info pages (e.g. "declaration vs certificate"
// explainer) — reusable model for future one-off content pages, not just
// this one, so it's keyed by slug rather than a dedicated table per page.
model InfoPage {
  id              String   @id @default(uuid())
  slug            String   @unique
  titleUz         String
  titleRu         String
  titleEn         String
  contentUz       String
  contentRu       String
  contentEn       String
  // Reference PDF for the declaration-vs-certificate page (Resolution
  // No. 43) — nullable since not every InfoPage needs it.
  document43Url   String?
  // Optional second section: a step-by-step how-to guide, shown below the
  // main content on the same page — nullable since not every InfoPage
  // needs one.
  guideTitleUz    String?
  guideTitleRu    String?
  guideTitleEn    String?
  guideContentUz  String?
  guideContentRu  String?
  guideContentEn  String?
  // Declaration-vs-certificate comparison cards: 5 newline-separated
  // values each, matching 5 fixed rows whose labels are hardcoded in the
  // frontend (i18n) rather than stored here.
  comparisonDeclarationUz String?
  comparisonDeclarationRu String?
  comparisonDeclarationEn String?
  comparisonCertificateUz String?
  comparisonCertificateRu String?
  comparisonCertificateEn String?
  // FAQ: blank-line separated Q/A blocks, first line of each block is the
  // question, the rest is the answer.
  faqUz           String?
  faqRu           String?
  faqEn           String?
  updatedAt       DateTime @updatedAt
}

// Test Program Builder: admins assemble a per-product accreditation-scope
// test program from a pool of TestIndicator rows, with some indicators
// conditional on a question/option (e.g. "Ishlaydigan kuchlanish?" -> 220V
// vs 380V pulls in different indicators). Public users answer the
// questions on the product page and get back the resolved indicator list,
// downloadable as a .docx.
model TestIndicator {
  id           String   @id @default(uuid())
  nameUz       String
  nameRu       String
  nameEn       String
  // Position number in the official accreditation-scope registry (e.g.
  // "21"), distinct from the indicator's own database id.
  positionCode String?
  standardCode String?
  laboratoryId String?
  laboratory   Laboratory? @relation(fields: [laboratoryId], references: [id])
  method       String?
  unit         String?
  assignments  ProductIndicatorAssignment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
}

model Product {
  id            String   @id @default(uuid())
  slug          String   @unique
  nameUz        String
  nameRu        String
  nameEn        String
  laboratoryId  String
  laboratory    Laboratory @relation(fields: [laboratoryId], references: [id])
  descriptionUz String?
  questions     ProductQuestion[]
  indicators    ProductIndicatorAssignment[]
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
}

model ProductQuestion {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  questionUz  String
  questionRu  String
  questionEn  String
  order       Int      @default(0)
  options     ProductQuestionOption[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductQuestionOption {
  id          String   @id @default(uuid())
  questionId  String
  question    ProductQuestion @relation(fields: [questionId], references: [id])
  labelUz     String
  labelRu     String
  labelEn     String
  order       Int      @default(0)
  assignments ProductIndicatorAssignment[]
  createdAt   DateTime @default(now())
}

// conditionOptionId = null means the indicator is "asosiy" (baseline) and
// is always included in the generated program; otherwise it is only
// included when the linked option is among the caller's selectedOptions.
model ProductIndicatorAssignment {
  id                String   @id @default(uuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  indicatorId       String
  indicator         TestIndicator @relation(fields: [indicatorId], references: [id])
  conditionOptionId String?
  conditionOption   ProductQuestionOption? @relation(fields: [conditionOptionId], references: [id])
  // Display order within its group (baseline, or the assignments under one
  // option) — admin-editable via drag-and-drop in the constructor.
  order             Int      @default(0)
  createdAt         DateTime @default(now())
}

// Muammo boshqaruvi: nomuvofiqliklar/CAPA va rasmiy sifat shikoyatlari.
// Qolgan 18 modul keyingi fazalarda shu bo'limga qo'shiladi.

// Sayt sahifalarining kunlik ko'rishlar soni — frontend har bir sahifa
// o'tishida (SPA ichida ham) yuboradi. Admin dashboarddagi "Eng ko'p
// ko'rilgan sahifalar" shundan olinadi (Cloudflare SPA ichidagi o'tishlarni
// ko'rmaydi).
model PageViewDaily {
  date  DateTime @db.Date
  path  String
  views Int      @default(0)

  @@id([date, path])
  @@index([date])
}

// ===== Hisobot: Sinovlar jurnali =====
// Excel'dagi "Журнал регистрации" ning tizimdagi ko'rinishi: bitta jurnal
// qatori = bitta TestJournalRecord. Dastlabki ma'lumot
// prisma/seed/importTestJournal.js orqali import qilinadi (importKey bo'yicha).

// Sinov yo'nalishlari spravochnigi (BZ, EMM, EE, Shovqin va SUPER_ADMIN
// qo'shgan yangilari). Yozuvlar yo'nalishni `code` bo'yicha saqlaydi, shuning
// uchun kod o'zgarmaydi; ishlatilgan yo'nalish o'chirilmaydi (nofaol qilinadi).
// SHOVQIN — maxsus: alohida varaq va alohida narx.
model TestDirectionType {
  id        String   @id @default(uuid())
  code      String   @unique
  short     String
  nameUz    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum JournalResult {
  MOS
  MOS_EMAS
  QISMAN_MOS_EMAS
  NAMUNA_TAQDIM_ETILMADI
  BEKOR_QILINDI
  KUTILMOQDA
  KORIB_CHIQISH
}

enum JournalPayment {
  TOLANGAN
  TOLANMAGAN
}

enum JournalCancelledBy {
  ARIZACHI
  ORGAN
}

model TestProductType {
  id        String              @id @default(uuid())
  code      String              @unique
  nameUz    String
  isActive  Boolean             @default(true)
  records   TestJournalRecord[]
  prices    TestJournalPrice[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model TestLocation {
  id        String              @id @default(uuid())
  code      String              @unique
  nameUz    String
  isActive  Boolean             @default(true)
  records   TestJournalRecord[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

// Buyurtmachi (sertifikatlashtirish idorasi). aliases — Excel'da uchragan
// boshqa yozilishlar (tirnoqli va h.k.), keyingi importlarda moslash uchun.
model CertificationBody {
  id        String              @id @default(uuid())
  name      String              @unique
  // Rasmiy to'liq nomi (reyestrdagi kabi); jurnalda qisqa `name` ko'rsatiladi.
  fullName  String?
  aliases   String[]            @default([])
  isActive  Boolean             @default(true)
  records   TestJournalRecord[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

// actNo takrorlanadi (bir akt bir necha qatorda), shuning uchun u UNIQUE
// emas — takrorlanmas kalit importKey ("<productType>:<varaq>:<qator>").
model TestJournalRecord {
  id                   String              @id @default(uuid())
  importKey            String?             @unique
  sourceSheet          String?
  sourceRow            Int?
  sheetNo              Int?
  journalYear          Int
  productTypeId        String
  productType          TestProductType     @relation(fields: [productTypeId], references: [id])
  certificationBodyId  String?
  certificationBody    CertificationBody?  @relation(fields: [certificationBodyId], references: [id])
  actNo                String?
  actDate              DateTime?           @db.Date
  executorName         String?
  sampleReceivedDate   DateTime?           @db.Date
  sampleReceivedTime   String?
  sampleCount          Int?
  cancelledSampleCount Int                 @default(0)
  weightNote           String?
  protocolDate         DateTime?           @db.Date
  directions           String[]
  result               JournalResult
  nonconformingCount   Int?
  cancelledBy          JournalCancelledBy?
  brand                String?
  locationId           String?
  location             TestLocation?       @relation(fields: [locationId], references: [id])
  isRepeat             Boolean             @default(false)
  contractNo           String?
  contractDate         DateTime?           @db.Date
  amount               Decimal?            @db.Decimal(14, 2)
  paymentStatus        JournalPayment?
  notes                String[]            @default([])
  raw                  Json?
  needsReview          Boolean             @default(false)
  reviewReasons        String[]            @default([])
  // SUPER_ADMIN qo'shgan qo'shimcha ustunlar qiymatlari: { ustunKaliti: qiymat }.
  customFields         Json?
  changes              TestJournalChange[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?

  @@index([actNo])
  @@index([sampleReceivedDate])
  @@index([productTypeId])
  @@index([certificationBodyId])
  @@index([result])
  @@index([needsReview])
  @@index([journalYear])
}

enum JournalChangeAction {
  CREATE
  UPDATE
  DELETE
}

// Jurnal yozuvining o'zgarishlar tarixi: kim, qachon, nima qildi.
// changes = { maydon: { from, to } } (UPDATE uchun); Excel'dan import
// qilingan yozuvlarda CREATE yozuvi bo'lmaydi (importKey buni bildiradi).
model TestJournalChange {
  id        String              @id @default(uuid())
  recordId  String
  record    TestJournalRecord   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    JournalChangeAction
  changes   Json?
  createdAt DateTime            @default(now())

  @@index([recordId])
}

// Bir namuna sinovi narxi — summani avtomatik hisoblash uchun.
// direction: null = asosiy sinovlar (BZ/EMM/EE), SHOVQIN = shovqin sinovi.
// Yozuv uchun akt sanasidan oldingi eng so'nggi validFrom narxi olinadi.
model TestJournalPrice {
  id            String          @id @default(uuid())
  productTypeId String
  productType   TestProductType @relation(fields: [productTypeId], references: [id])
  direction     String?
  unitPrice     Decimal         @db.Decimal(14, 2)
  validFrom     DateTime        @db.Date
  note          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([productTypeId, validFrom])
}

// Jurnal jadvalining ustunlari: tartibi, ko'rinishi va SUPER_ADMIN qo'shgan
// qo'shimcha ustunlar. Hamma uchun bitta umumiy sozlama (id = "default").
// columns = [{ key, hidden?, custom?, label?, type? }]
model TestJournalLayout {
  id        String   @id
  columns   Json
  updatedAt DateTime @updatedAt
}

// ===== Vazifalar menejeri =====

enum TaskStatus {
  YANGI
  JARAYONDA
  TEKSHIRUVDA
  BAJARILDI
  BEKOR_QILINDI
}

enum TaskPriority {
  PAST
  ORTACHA
  YUQORI
  SHOSHILINCH
}

enum TaskRelatedType {
  ARIZA
  NAMUNA
  NOMUVOFIQLIK
  JURNAL
  BOSHQA
}

// Ko'rish/o'zgartirish huquqlari: src/utils/taskPermissions.js.
model Task {
  id           String           @id @default(uuid())
  title        String
  description  String?
  status       TaskStatus       @default(YANGI)
  priority     TaskPriority     @default(ORTACHA)
  dueDate      DateTime?        @db.Date
  completedAt  DateTime?
  creatorId    String
  creator      User             @relation("TaskCreator", fields: [creatorId], references: [id])
  laboratoryId String?
  laboratory   Laboratory?      @relation(fields: [laboratoryId], references: [id])
  relatedType  TaskRelatedType?
  relatedId    String?
  relatedLabel String?
  assignees    TaskAssignee[]
  checklist    TaskChecklistItem[]
  comments     TaskComment[]
  attachments  TaskAttachment[]
  activities   TaskActivity[]
  notifications Notification[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  @@index([status])
  @@index([dueDate])
  @@index([creatorId])
  @@index([laboratoryId])
}

model TaskAssignee {
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([taskId, userId])
  @@index([userId])
}

model TaskChecklistItem {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskAttachment {
  id           String   @id @default(uuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileUrl      String
  fileName     String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([taskId])
}

// Avtomatik faoliyat tarixi: action = CREATED, UPDATED, STATUS, ASSIGNED,
// COMMENT, CHECKLIST, ATTACHMENT, DELETED; meta = tafsilotlar.
model TaskActivity {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([taskId])
}

// Shaxsiy bildirishnomalar (sarlavhadagi qo'ng'iroqcha). type: TASK_ASSIGNED,
// TASK_STATUS, TASK_COMMENT, TASK_DUE_SOON, TASK_OVERDUE.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  linkUrl   String?
  taskId    String?
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([taskId, type, userId, createdAt])
}

// ---------------------------------------------------------------------------
// Chat (ichki messenjer). Kirish faqat a'zolik orqali tekshiriladi: a'zo
// bo'lmagan xona/xabar/fayl uchun API 404 qaytaradi. Media fayllar
// CHAT_STORAGE_DIR'da (ommaviy /uploads'da emas) va faqat imzolangan
// qisqa muddatli havola bilan beriladi.
// ---------------------------------------------------------------------------

enum ChatRoomType {
  DIRECT
  GROUP
  LABORATORY
  GENERAL
  ANNOUNCEMENT
}

enum ChatMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum ChatMessageType {
  TEXT
  IMAGE
  VIDEO
  VIDEO_NOTE
  VOICE
  FILE
  STICKER
  SYSTEM
}

enum ChatAttachmentKind {
  IMAGE
  VIDEO
  AUDIO
  FILE
}

enum ChatAttachmentStatus {
  PENDING
  ATTACHED
}

enum ChatGroupCreators {
  ALL
  MANAGERS
}

model ChatRoom {
  id           String        @id @default(uuid())
  type         ChatRoomType
  title        String?
  // LABORATORY: har laboratoriyaga bitta xona.
  laboratoryId String?       @unique
  laboratory   Laboratory?   @relation(fields: [laboratoryId], references: [id], onDelete: SetNull)
  // DIRECT: "kichikId:kattaId" — ikki kishi orasida bitta xona.
  directKey    String?       @unique
  createdById  String?
  createdBy    User?         @relation("ChatRoomCreator", fields: [createdById], references: [id], onDelete: SetNull)
  isArchived   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  members      ChatMember[]
  messages     ChatMessage[]
  pins         ChatPinned[]

  @@index([type])
}

model ChatMember {
  id                String         @id @default(uuid())
  roomId            String
  room              ChatRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              ChatMemberRole @default(MEMBER)
  lastReadAt        DateTime?
  lastReadMessageId String?
  mutedUntil        DateTime?
  joinedAt          DateTime       @default(now())
  leftAt            DateTime?

  @@unique([roomId, userId])
  @@index([userId, leftAt])
}

model ChatMessage {
  id              String              @id @default(uuid())
  roomId          String
  room            ChatRoom            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User                @relation(fields: [senderId], references: [id])
  type            ChatMessageType     @default(TEXT)
  body            String?             @db.VarChar(4000)
  replyToId       String?
  replyTo         ChatMessage?        @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         ChatMessage[]       @relation("ChatReply")
  forwardedFromId String?
  forwardedFrom   ChatMessage?        @relation("ChatForward", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwards        ChatMessage[]       @relation("ChatForward")
  // duration, waveform (~48 son), width/height, mentions, stickerId ...
  meta            Json?
  // Klient yaratgan id: qayta yuborishda dublikat bo'lmasligi uchun.
  clientId        String
  editedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  attachments     ChatAttachment[]
  reactions       ChatReaction[]
  pins            ChatPinned[]
  hiddenFor       ChatMessageHidden[]

  @@unique([senderId, clientId])
  @@index([roomId, createdAt, id])
}

model ChatAttachment {
  id           String               @id @default(uuid())
  messageId    String?
  message      ChatMessage?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploaderId   String
  uploader     User                 @relation(fields: [uploaderId], references: [id])
  storageKey   String               @unique
  originalName String
  mime         String
  size         Int
  kind         ChatAttachmentKind
  width        Int?
  height       Int?
  durationSec  Float?
  thumbKey     String?
  status       ChatAttachmentStatus @default(PENDING)
  // Saqlash muddati tugab, fayl diskdan o'chirilgan ("Fayl muddati tugagan").
  expiredAt    DateTime?
  createdAt    DateTime             @default(now())

  @@index([messageId])
  @@index([status, createdAt])
}

model ChatReaction {
  id        String      @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String      @db.VarChar(32)
  createdAt DateTime    @default(now())

  @@unique([messageId, userId, emoji])
}

model ChatPinned {
  id         String      @id @default(uuid())
  roomId     String
  room       ChatRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  messageId  String
  message    ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedById String
  pinnedBy   User        @relation(fields: [pinnedById], references: [id])
  createdAt  DateTime    @default(now())

  @@unique([roomId, messageId])
}

// "Faqat men uchun o'chirish".
model ChatMessageHidden {
  id        String      @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([messageId, userId])
}

model StickerPack {
  id          String    @id @default(uuid())
  title       String
  isActive    Boolean   @default(true)
  order       Int       @default(0)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  stickers    Sticker[]
}

model Sticker {
  id         String      @id @default(uuid())
  packId     String
  pack       StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  storageKey String      @unique
  mime       String
  emoji      String?
  order      Int         @default(0)
  createdAt  DateTime    @default(now())

  @@index([packId, order])
}

// Yagona qator (id = 1).
model ChatSetting {
  id                        Int               @id @default(1)
  maxImageMB                Int               @default(20)
  maxVideoMB                Int               @default(95)
  maxAudioMB                Int               @default(20)
  maxFileMB                 Int               @default(50)
  maxVoiceSeconds           Int               @default(300)
  maxVideoNoteSeconds       Int               @default(60)
  editWindowMinutes         Int               @default(1440)
  deleteForAllWindowMinutes Int               @default(1440)
  mediaRetentionDays        Int               @default(0)
  whoCanCreateGroups        ChatGroupCreators @default(ALL)
  chatEnabled               Boolean           @default(true)
  updatedAt                 DateTime          @updatedAt
}

// Kirish tarixi. Muvaffaqiyatsiz urinish faqat mavjud hisob uchun yoziladi;
// parol hech qachon saqlanmaydi. 90 kundan eskilari cron bilan o'chiriladi.
model LoginEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Faol qurilmalar: har bir kirish — bitta sessiya. Refresh token faqat xesh
// ko'rinishida saqlanadi; bekor qilingan sessiyaning refresh'i rad etiladi.
model UserSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  ip               String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId, revokedAt])
}

// ===== SMK (Sifat menejmenti, ISO/IEC 17025): elektron formalar =====
// Formalar kutubxonasi (SUPER_ADMIN yuritadi). `fields` — maydonlar ro'yxati:
// [{ key, label, type, required, options }], type: text | textarea | number |
// date | select | checkbox | staff | file. templateUrl — asl shablon fayli
// (Word/Excel/PDF), yuklab olish uchun.
model SmkForm {
  id           String         @id @default(uuid())
  code         String         @unique
  title        String
  description  String?
  fields       Json           @default("[]")
  templateUrl  String?
  templateName String?
  order        Int            @default(0)
  isActive     Boolean        @default(true)
  labs         SmkLabForm[]
  entries      SmkFormEntry[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// Laboratoriya o'ziga kerakli formalarni tanlaydi (Sifat kanbanidagi kartochkalar).
model SmkLabForm {
  laboratoryId String
  laboratory   Laboratory @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)
  formId       String
  form         SmkForm    @relation(fields: [formId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([laboratoryId, formId])
  @@index([formId])
}

// To'ldirilgan forma (bitta yozuv). data — { [field.key]: qiymat }.
model SmkFormEntry {
  id           String     @id @default(uuid())
  formId       String
  form         SmkForm    @relation(fields: [formId], references: [id])
  laboratoryId String
  laboratory   Laboratory @relation(fields: [laboratoryId], references: [id])
  data         Json       @default("{}")
  createdById  String?
  createdBy    User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([formId, laboratoryId, createdAt])
  @@index([laboratoryId])
}
