  laboratoryId String?
  laboratory   Laboratory? @relation(fields: [laboratoryId], references: [id])
  submittedByUserId   String?
  submittedByUser     User?                        @relation(fields: [submittedByUserId], references: [id])
  description         String
  submittedDate       DateTime
  status              ImprovementSuggestionStatus  @default(KORIB_CHIQILMOQDA)
  implementationNotes String?
  createdAt           DateTime                     @default(now())

  @@index([laboratoryId])
}

model RetentionPolicy {
  id             String   @id @default(uuid())
  laboratoryId String?
  laboratory   Laboratory? @relation(fields: [laboratoryId], references: [id])
  documentType   String
  retentionYears Int
  notes          String?
  createdAt      DateTime @default(now())

  @@index([laboratoryId])
}
// Sayt sahifalarining kunlik ko'rishlar soni — frontend har bir sahifa
// o'tishida (SPA ichida ham) yuboradi. Admin dashboarddagi "Eng ko'p
// ko'rilgan sahifalar" shundan olinadi (Cloudflare SPA ichidagi o'tishlarni
// ko'rmaydi).
model PageViewDaily {
  date  DateTime @db.Date
  path  String
  views Int      @default(0)

  @@id([date, path])
  @@index([date])
}

// ===== Hisobot: Sinovlar jurnali =====
// Excel'dagi "Журнал регистрации" ning tizimdagi ko'rinishi: bitta jurnal
// qatori = bitta TestJournalRecord. Dastlabki ma'lumot
// prisma/seed/importTestJournal.js orqali import qilinadi (importKey bo'yicha).

enum TestDirection {
  XAVFSIZLIK
  EMC
  ENERGIYA
  SHOVQIN
}

enum JournalResult {
  MOS
  MOS_EMAS
  QISMAN_MOS_EMAS
  NAMUNA_TAQDIM_ETILMADI
  BEKOR_QILINDI
  KUTILMOQDA
  KORIB_CHIQISH
}

enum JournalPayment {
  TOLANGAN
  TOLANMAGAN
}

enum JournalCancelledBy {
  ARIZACHI
  ORGAN
}

model TestProductType {
  id        String              @id @default(uuid())
  code      String              @unique
  nameUz    String
  isActive  Boolean             @default(true)
  records   TestJournalRecord[]
  prices    TestJournalPrice[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model TestLocation {
  id        String              @id @default(uuid())
  code      String              @unique
  nameUz    String
  isActive  Boolean             @default(true)
  records   TestJournalRecord[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

// Buyurtmachi (sertifikatlashtirish idorasi). aliases — Excel'da uchragan
// boshqa yozilishlar (tirnoqli va h.k.), keyingi importlarda moslash uchun.
model CertificationBody {
  id        String              @id @default(uuid())
  name      String              @unique
  aliases   String[]            @default([])
  isActive  Boolean             @default(true)
  records   TestJournalRecord[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

// actNo takrorlanadi (bir akt bir necha qatorda), shuning uchun u UNIQUE
// emas — takrorlanmas kalit importKey ("<productType>:<varaq>:<qator>").
model TestJournalRecord {
  id                   String              @id @default(uuid())
  importKey            String?             @unique
  sourceSheet          String?
  sourceRow            Int?
  sheetNo              Int?
  journalYear          Int
  productTypeId        String
  productType          TestProductType     @relation(fields: [productTypeId], references: [id])
  certificationBodyId  String?
  certificationBody    CertificationBody?  @relation(fields: [certificationBodyId], references: [id])
  actNo                String?
  actDate              DateTime?           @db.Date
  executorName         String?
  sampleReceivedDate   DateTime?           @db.Date
  sampleReceivedTime   String?
  sampleCount          Int?
  cancelledSampleCount Int                 @default(0)
  weightNote           String?
  protocolDate         DateTime?           @db.Date
  directions           TestDirection[]
  result               JournalResult
  nonconformingCount   Int?
  cancelledBy          JournalCancelledBy?
  brand                String?
  locationId           String?
  location             TestLocation?       @relation(fields: [locationId], references: [id])
  isRepeat             Boolean             @default(false)
  contractNo           String?
  contractDate         DateTime?           @db.Date
  amount               Decimal?            @db.Decimal(14, 2)
  paymentStatus        JournalPayment?
  notes                String[]            @default([])
  raw                  Json?
  needsReview          Boolean             @default(false)
  reviewReasons        String[]            @default([])
  // SUPER_ADMIN qo'shgan qo'shimcha ustunlar qiymatlari: { ustunKaliti: qiymat }.
  customFields         Json?
  changes              TestJournalChange[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?

  @@index([actNo])
  @@index([sampleReceivedDate])
  @@index([productTypeId])
  @@index([certificationBodyId])
  @@index([result])
  @@index([needsReview])
  @@index([journalYear])
}

enum JournalChangeAction {
  CREATE
  UPDATE
  DELETE
}

// Jurnal yozuvining o'zgarishlar tarixi: kim, qachon, nima qildi.
// changes = { maydon: { from, to } } (UPDATE uchun); Excel'dan import
// qilingan yozuvlarda CREATE yozuvi bo'lmaydi (importKey buni bildiradi).
model TestJournalChange {
  id        String              @id @default(uuid())
  recordId  String
  record    TestJournalRecord   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    JournalChangeAction
  changes   Json?
  createdAt DateTime            @default(now())

  @@index([recordId])
}

// Bir namuna sinovi narxi — summani avtomatik hisoblash uchun.
// direction: null = asosiy sinovlar (BZ/EMM/EE), SHOVQIN = shovqin sinovi.
// Yozuv uchun akt sanasidan oldingi eng so'nggi validFrom narxi olinadi.
model TestJournalPrice {
  id            String          @id @default(uuid())
  productTypeId String
  productType   TestProductType @relation(fields: [productTypeId], references: [id])
  direction     TestDirection?
  unitPrice     Decimal         @db.Decimal(14, 2)
  validFrom     DateTime        @db.Date
  note          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([productTypeId, validFrom])
}

// Jurnal jadvalining ustunlari: tartibi, ko'rinishi va SUPER_ADMIN qo'shgan
// qo'shimcha ustunlar. Hamma uchun bitta umumiy sozlama (id = "default").
// columns = [{ key, hidden?, custom?, label?, type? }]
model TestJournalLayout {
  id        String   @id
  columns   Json
  updatedAt DateTime @updatedAt
}

// ===== Vazifalar menejeri =====

enum TaskStatus {
  YANGI
  JARAYONDA
  TEKSHIRUVDA
  BAJARILDI
  BEKOR_QILINDI
}

enum TaskPriority {
  PAST
  ORTACHA
  YUQORI
  SHOSHILINCH
}

enum TaskRelatedType {
  ARIZA
  NAMUNA
  NOMUVOFIQLIK
  JURNAL
  BOSHQA
}

// Ko'rish/o'zgartirish huquqlari: src/utils/taskPermissions.js.
model Task {
  id           String           @id @default(uuid())
  title        String
  description  String?
  status       TaskStatus       @default(YANGI)
  priority     TaskPriority     @default(ORTACHA)
  dueDate      DateTime?        @db.Date
  completedAt  DateTime?
  creatorId    String
  creator      User             @relation("TaskCreator", fields: [creatorId], references: [id])
  laboratoryId String?
  laboratory   Laboratory?      @relation(fields: [laboratoryId], references: [id])
  relatedType  TaskRelatedType?
  relatedId    String?
  relatedLabel String?
  assignees    TaskAssignee[]
  checklist    TaskChecklistItem[]
  comments     TaskComment[]
  attachments  TaskAttachment[]
  activities   TaskActivity[]
  notifications Notification[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  @@index([status])
  @@index([dueDate])
  @@index([creatorId])
  @@index([laboratoryId])
}

model TaskAssignee {
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([taskId, userId])
  @@index([userId])
}

model TaskChecklistItem {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskAttachment {
  id           String   @id @default(uuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileUrl      String
  fileName     String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([taskId])
}

// Avtomatik faoliyat tarixi: action = CREATED, UPDATED, STATUS, ASSIGNED,
// COMMENT, CHECKLIST, ATTACHMENT, DELETED; meta = tafsilotlar.
model TaskActivity {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([taskId])
}

// Shaxsiy bildirishnomalar (sarlavhadagi qo'ng'iroqcha). type: TASK_ASSIGNED,
// TASK_STATUS, TASK_COMMENT, TASK_DUE_SOON, TASK_OVERDUE.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  linkUrl   String?
  taskId    String?
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([taskId, type, userId, createdAt])
}

// ---------------------------------------------------------------------------
// Chat (ichki messenjer). Kirish faqat a'zolik orqali tekshiriladi: a'zo
// bo'lmagan xona/xabar/fayl uchun API 404 qaytaradi. Media fayllar
// CHAT_STORAGE_DIR'da (ommaviy /uploads'da emas) va faqat imzolangan
// qisqa muddatli havola bilan beriladi.
// ---------------------------------------------------------------------------

enum ChatRoomType {
  DIRECT
  GROUP
  LABORATORY
  GENERAL
  ANNOUNCEMENT
}

enum ChatMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum ChatMessageType {
  TEXT
  IMAGE
  VIDEO
  VIDEO_NOTE
  VOICE
  FILE
  STICKER
  SYSTEM
}

enum ChatAttachmentKind {
  IMAGE
  VIDEO
  AUDIO
  FILE
}

enum ChatAttachmentStatus {
  PENDING
  ATTACHED
}

enum ChatGroupCreators {
  ALL
  MANAGERS
}

model ChatRoom {
  id           String        @id @default(uuid())
  type         ChatRoomType
  title        String?
  // LABORATORY: har laboratoriyaga bitta xona.
  laboratoryId String?       @unique
  laboratory   Laboratory?   @relation(fields: [laboratoryId], references: [id], onDelete: SetNull)
  // DIRECT: "kichikId:kattaId" — ikki kishi orasida bitta xona.
  directKey    String?       @unique
  createdById  String?
  createdBy    User?         @relation("ChatRoomCreator", fields: [createdById], references: [id], onDelete: SetNull)
  isArchived   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  members      ChatMember[]
  messages     ChatMessage[]
  pins         ChatPinned[]

  @@index([type])
}

model ChatMember {
  id                String         @id @default(uuid())
  roomId            String
  room              ChatRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              ChatMemberRole @default(MEMBER)
  lastReadAt        DateTime?
  lastReadMessageId String?
  mutedUntil        DateTime?
  joinedAt          DateTime       @default(now())
  leftAt            DateTime?

  @@unique([roomId, userId])
  @@index([userId, leftAt])
}

model ChatMessage {
  id              String              @id @default(uuid())
  roomId          String
  room            ChatRoom            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User                @relation(fields: [senderId], references: [id])
  type            ChatMessageType     @default(TEXT)
  body            String?             @db.VarChar(4000)
  replyToId       String?
  replyTo         ChatMessage?        @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         ChatMessage[]       @relation("ChatReply")
  forwardedFromId String?
  forwardedFrom   ChatMessage?        @relation("ChatForward", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwards        ChatMessage[]       @relation("ChatForward")
  // duration, waveform (~48 son), width/height, mentions, stickerId ...
  meta            Json?
  // Klient yaratgan id: qayta yuborishda dublikat bo'lmasligi uchun.
  clientId        String
  editedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  attachments     ChatAttachment[]
  reactions       ChatReaction[]
  pins            ChatPinned[]
  hiddenFor       ChatMessageHidden[]

  @@unique([senderId, clientId])
  @@index([roomId, createdAt, id])
}

model ChatAttachment {
  id           String               @id @default(uuid())
  messageId    String?
  message      ChatMessage?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploaderId   String
  uploader     User                 @relation(fields: [uploaderId], references: [id])
  storageKey   String               @unique
  originalName String
  mime         String
  size         Int
  kind         ChatAttachmentKind
  width        Int?
  height       Int?
  durationSec  Float?
  thumbKey     String?
  status       ChatAttachmentStatus @default(PENDING)
  // Saqlash muddati tugab, fayl diskdan o'chirilgan ("Fayl muddati tugagan").
  expiredAt    DateTime?
  createdAt    DateTime             @default(now())

  @@index([messageId])
  @@index([status, createdAt])
}

model ChatReaction {
  id        String      @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String      @db.VarChar(32)
  createdAt DateTime    @default(now())

  @@unique([messageId, userId, emoji])
}

model ChatPinned {
  id         String      @id @default(uuid())
  roomId     String
  room       ChatRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  messageId  String
  message    ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedById String
  pinnedBy   User        @relation(fields: [pinnedById], references: [id])
  createdAt  DateTime    @default(now())

  @@unique([roomId, messageId])
}

// "Faqat men uchun o'chirish".
model ChatMessageHidden {
  id        String      @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([messageId, userId])
}

model StickerPack {
  id          String    @id @default(uuid())
  title       String
  isActive    Boolean   @default(true)
  order       Int       @default(0)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  stickers    Sticker[]
}

model Sticker {
  id         String      @id @default(uuid())
  packId     String
  pack       StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  storageKey String      @unique
  mime       String
  emoji      String?
  order      Int         @default(0)
  createdAt  DateTime    @default(now())

  @@index([packId, order])
}

// Yagona qator (id = 1).
model ChatSetting {
  id                        Int               @id @default(1)
  maxImageMB                Int               @default(20)
