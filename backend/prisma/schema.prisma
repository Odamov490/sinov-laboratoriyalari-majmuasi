generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  MANAGER
  EDITOR
  // Xodim: faqat vazifalar, bildirishnomalar va o'z profili.
  STAFF
}

enum ApplicationStatus {
  QABUL_QILINDI
  KORIB_CHIQILMOQDA
  SINOV_JARAYONIDA
  NATIJA_TAYYOR
  YAKUNLANDI
  BEKOR_QILINDI
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  labId        String?
  lab          Laboratory? @relation(fields: [labId], references: [id])
  isActive     Boolean  @default(true)
  // Mutaxassis (Staff) kartasiga bog'langan hisob; login = email.
  staffId            String?   @unique
  staff              Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  // Chat: SUPER_ADMIN shaxsan o'chirib qo'yishi mumkin; lastSeenAt — oxirgi socket uzilishi.
  chatEnabled        Boolean   @default(true)
  lastSeenAt         DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
  sampleMovements SampleMovement[]
  testItemsAdded  ApplicationTestItem[]
  nonConformancesResponsible NonConformance[]
  complaintsResponsible      Complaint[]
  smkDocumentsOwned            SMKDocument[]
  smkDocumentVersionsApproved   SMKDocumentVersion[]
  internalAuditsAsAuditor       InternalAudit[]
  trainingRecords                TrainingRecord[]
  impartialityDeclarations       ImpartialityDeclaration[]
  documentAcknowledgments         DocumentAcknowledgment[]
  riskItemsOwned                  RiskItem[]
  improvementSuggestions           ImprovementSuggestion[]
  testJournalChanges               TestJournalChange[]
  tasksCreated                     Task[]             @relation("TaskCreator")
  taskAssignments                  TaskAssignee[]
  taskComments                     TaskComment[]
  taskAttachments                  TaskAttachment[]
  taskActivities                   TaskActivity[]
  notifications                    Notification[]
  chatRoomsCreated                 ChatRoom[]          @relation("ChatRoomCreator")
  chatMemberships                  ChatMember[]
  chatMessages                     ChatMessage[]
  chatAttachments                  ChatAttachment[]
  chatReactions                    ChatReaction[]
  chatPins                         ChatPinned[]
  chatHidden                       ChatMessageHidden[]
  stickerPacksCreated              StickerPack[]
}

model Laboratory {
  id                  String   @id @default(uuid())
  slug                String   @unique
  nameUz              String
  nameRu              String
  nameEn              String
  descriptionUz       String?
  descriptionRu       String?
  descriptionEn       String?
  aboutUz             String?
  aboutRu             String?
  aboutEn             String?
  accreditationScope  String?
  coverImage          String?
  order               Int      @default(0)
  isActive            Boolean  @default(true)
  services            Service[]
  equipment           Equipment[]
  staff               Staff[]
  standards           Standard[]
  gallery             Gallery[]
  samplesOrigin       Sample[] @relation("SampleOrigin")
  samplesCurrent      Sample[] @relation("SampleCurrent")
  movementsFrom       SampleMovement[] @relation("MovementFrom")
  movementsTo         SampleMovement[] @relation("MovementTo")
  users               User[]
  testIndicators      TestIndicator[]
  products            Product[]
  internalAudits          InternalAudit[]
  tasks                   Task[]
  chatRoom                ChatRoom?
  qualityControlRecords   QualityControlRecord[]
  proficiencyTests        ProficiencyTest[]
  environmentLogs         EnvironmentLog[]
  // SMK har bir laboratoriya uchun alohida yuritiladi.
  smkNonConformances          NonConformance[]
  smkComplaints               Complaint[]
  smkDocuments                SMKDocument[]
  smkDocumentVersions         SMKDocumentVersion[]
  smkAuditFindings            AuditFinding[]
  smkCalibrationRecords       CalibrationRecord[]
  smkTrainingRecords          TrainingRecord[]
  smkMeasurementUncertainties MeasurementUncertainty[]
  smkMethodValidations        MethodValidation[]
  smkImpartialityDeclarations ImpartialityDeclaration[]
  smkSupplierEvaluations      SupplierEvaluation[]
  smkSubcontractors           Subcontractor[]
  smkDocumentAcknowledgments  DocumentAcknowledgment[]
  smkManagementReviews        ManagementReview[]
  smkRiskItems                RiskItem[]
  smkQualityObjectives        QualityObjective[]
  smkImprovementSuggestions   ImprovementSuggestion[]
  smkRetentionPolicies        RetentionPolicy[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?
}

model ServiceCategory {
  id        String    @id @default(uuid())
  nameUz    String
  nameRu    String
  nameEn    String
  services  Service[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Service {
  id              String   @id @default(uuid())
  slug            String   @unique
  nameUz          String
  nameRu          String
  nameEn          String
  descriptionUz   String?
  descriptionRu   String?
  descriptionEn   String?
  testObject      String?
  testType        String?
  durationDays    Int?
  laboratoryId    String
  laboratory      Laboratory @relation(fields: [laboratoryId], references: [id])
  categoryId      String?
  category        ServiceCategory? @relation(fields: [categoryId], references: [id])
  standardId      String?
  standard        Standard? @relation(fields: [standardId], references: [id])
  prices          Price[]
  applications    Application[]
  testItems       ApplicationTestItem[]
  measurementUncertainties MeasurementUncertainty[]
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
}

model Price {
  id            String   @id @default(uuid())
  serviceId     String
  service       Service  @relation(fields: [serviceId], references: [id])
  amount        Decimal? @db.Decimal(14, 2)
  currency      String   @default("UZS")
  effectiveFrom DateTime @default(now())
  isCurrent     Boolean  @default(true)
  history       PriceHistory[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PriceHistory {
  id            String   @id @default(uuid())
  priceId       String
  price         Price    @relation(fields: [priceId], references: [id])
  amount        Decimal? @db.Decimal(14, 2)
  currency      String   @default("UZS")
  changedAt     DateTime @default(now())
}

model Standard {
  id            String   @id @default(uuid())
  code          String   @unique
  nameUz        String
  nameRu        String
  nameEn        String
  category      String
  scopeUz       String?
  scopeRu       String?
  scopeEn       String?
  documentUrl   String?
  laboratoryId  String?
  laboratory    Laboratory? @relation(fields: [laboratoryId], references: [id])
  services      Service[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
}

model NewsCategory {
  id      String @id @default(uuid())
  nameUz  String
  nameRu  String
  nameEn  String
  news    News[]
}

model News {
  id              String   @id @default(uuid())
  slug            String   @unique
  titleUz         String
  titleRu         String
  titleEn         String
  descriptionUz   String?
  descriptionRu   String?
  descriptionEn   String?
  contentUz       String?
  contentRu       String?
  contentEn       String?
  image           String?
  categoryId      String?
  category        NewsCategory? @relation(fields: [categoryId], references: [id])
  seoTitle        String?
  seoDescription  String?
  isPublished     Boolean  @default(false)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
}

model DocumentCategory {
  id        String     @id @default(uuid())
  nameUz    String
  nameRu    String
  nameEn    String
  documents Document[]
}

model Document {
  id          String   @id @default(uuid())
  titleUz     String
  titleRu     String
  titleEn     String
  fileUrl     String
  categoryId  String?
  category    DocumentCategory? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model Staff {
  id              String   @id @default(uuid())
  fullName        String
  position        String
  specialization  String?
  experienceYears Int?
  email           String?
  phone           String?
  photo           String?
  laboratoryId    String?
  laboratory      Laboratory? @relation(fields: [laboratoryId], references: [id])
  order           Int      @default(0)
  // Internal HR fields -- admin-only, never returned by the public API
  // (see getStaff's explicit `select` in publicController.js).
  staffNumber     Int?
  employeeCode    String?
  hireDate        DateTime?
  birthDate       DateTime?
  passportSeries  String?
  passportNumber  String?
  pinfl           String?
  address         String?
  notes           String?
  // Nofaol mutaxassisning bog'langan hisobi ham nofaol qilinadi.
  isActive        Boolean  @default(true)
  account         User?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
}

model Equipment {
  id             String   @id @default(uuid())
  slug           String   @unique
  name           String
  manufacturer   String?
  model          String?
  specifications String?
  application    String?
  photo          String?
  laboratoryId   String?
  laboratory     Laboratory? @relation(fields: [laboratoryId], references: [id])
  calibrationRecords CalibrationRecord[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
}

model GalleryCategory {
  id      String    @id @default(uuid())
  nameUz  String
  nameRu  String
  nameEn  String
  items   Gallery[]
}

model Gallery {
  id           String   @id @default(uuid())
  title        String?
  imageUrl     String
  categoryId   String?
  category     GalleryCategory? @relation(fields: [categoryId], references: [id])
  laboratoryId String?
  laboratory   Laboratory? @relation(fields: [laboratoryId], references: [id])
  createdAt    DateTime @default(now())
}

model FAQ {
  id          String   @id @default(uuid())
  questionUz  String
  questionRu  String
  questionEn  String
  answerUz    String
  answerRu    String
  answerEn    String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Application {
  id                String   @id @default(uuid())
  applicationNumber String   @unique
  fullName          String
  organization      String?
  phone             String
  email             String?
  productName       String
  productType       String?
  laboratoryId      String?
  serviceId         String?
  service           Service? @relation(fields: [serviceId], references: [id])
  tnVedCode         String?
  productDescription String?
  testType          String?
  comment           String?
  tnVedWarningShown    Boolean @default(false)
  tnVedWarningCategory String?
  status            ApplicationStatus @default(QABUL_QILINDI)
  statusComment     String?
  samples         Sample[]
  files             ApplicationFile[]
  testItems         ApplicationTestItem[]
  complaints        Complaint[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ApplicationTestItem {
  id            String       @id @default(uuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id])
  serviceId     String
  service       Service      @relation(fields: [serviceId], references: [id])
  addedByUserId String?
  addedByUser   User?        @relation(fields: [addedByUserId], references: [id])
  createdAt     DateTime     @default(now())
}

model ApplicationFile {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  fileUrl       String
  originalName  String
  mimeType      String
  size          Int
  createdAt     DateTime    @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  fullName  String
  phone     String?
  email     String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Accreditation {
  id                String   @id @default(uuid())
  certificateNumber String
  standardCode      String
  scopeUz           String?
  scopeRu           String?
  scopeEn           String?
  documentUrl       String?
  // Link to the official accreditation-scope document on the national
  // akkred.uz system — kept as a plain admin-editable URL (not an uploaded
  // file) since the scope there changes often and this just needs to point
  // at whatever the current one is.
  scopeUrl          String?
  issuedAt          DateTime?
  validUntil        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SiteSetting {
  id            String   @id @default(uuid())
  key           String   @unique
  value         String?
  updatedAt     DateTime @updatedAt
}


enum SampleStatus {
  LABORATORIYADA
  TASHILMOQDA
  YAKUNLANDI
}

enum MovementAction {
  REGISTRATSIYA
  CHIQARISH
  QABUL_QILISH
  YAKUNLASH
}

model Sample {
  id            String       @id @default(uuid())
  code          String       @unique
  productName   String
  description   String?
  originLabId   String
  originLab     Laboratory   @relation("SampleOrigin", fields: [originLabId], references: [id])
  currentLabId  String?
  currentLab    Laboratory?  @relation("SampleCurrent", fields: [currentLabId], references: [id])
  status        SampleStatus @default(LABORATORIYADA)
  dueDate       DateTime?
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  photoUrl      String?
  reportUrl     String?
  movements     SampleMovement[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
}

model SampleMovement {
  id                String         @id @default(uuid())
  sampleId          String
  sample            Sample         @relation(fields: [sampleId], references: [id])
  fromLabId         String?
  fromLab           Laboratory?    @relation("MovementFrom", fields: [fromLabId], references: [id])
  toLabId           String?
  toLab             Laboratory?    @relation("MovementTo", fields: [toLabId], references: [id])
  action            MovementAction
  performedByUserId String?
  performedByUser   User?          @relation(fields: [performedByUserId], references: [id])
  performedByName   String?
  notes             String?
  createdAt         DateTime       @default(now())
}

enum TnVedRegulationCategory {
  SERTIFIKAT
  DEKLARATSIYA
}

// Reference table for mandatory conformity requirements (Cabinet of Ministers
// resolution 43): which HS/TN VED code ranges require a mandatory
// certificate vs. a declaration of conformity. tnVedRaw keeps the original
// legal-text range/exception wording verbatim (see parseTnVedRanges — it is
// only approximately machine-parseable at the 4-digit heading level).
model TnVedRegulation {
  id        String                  @id @default(uuid())
  item      String
  nameUz    String
  tnVedRaw  String
  category  TnVedRegulationCategory
  decision  String
  createdAt DateTime                @default(now())
}

// Reference data from Cabinet of Ministers resolution No. 733 (2022-12-31,
// Annex 1): TIF TN (HS) code version lookup, unrelated to the
// certificate/declaration requirement above. Two tables:
//  - TnVedCurrentCode: codes confirmed to exist under the 2022 revision.
//  - TnVedCodeConversion: old (2017) codes that were renumbered/split, with
//    their 2022 successor code(s).
// A code not present in EITHER table is not claimed to "not exist" — this
// source only lists codes that changed, so an unlisted code is treated as
// unchanged between the 2017 and 2022 revisions.
model TnVedCurrentCode {
  id        String   @id @default(uuid())
  digits    String   @unique
  display   String
  nameUz    String?
  createdAt DateTime @default(now())
}

model TnVedCodeConversion {
  id         String   @id @default(uuid())
  oldDigits  String   @unique
  oldDisplay String
  newCodes   Json
  createdAt  DateTime @default(now())
}

// Admin-editable public info pages (e.g. "declaration vs certificate"
// explainer) — reusable model for future one-off content pages, not just
// this one, so it's keyed by slug rather than a dedicated table per page.
model InfoPage {
  id              String   @id @default(uuid())
  slug            String   @unique
  titleUz         String
  titleRu         String
  titleEn         String
  contentUz       String
  contentRu       String
  contentEn       String
  // Reference PDF for the declaration-vs-certificate page (Resolution
  // No. 43) — nullable since not every InfoPage needs it.
  document43Url   String?
  // Optional second section: a step-by-step how-to guide, shown below the
  // main content on the same page — nullable since not every InfoPage
  // needs one.
  guideTitleUz    String?
  guideTitleRu    String?
  guideTitleEn    String?
  guideContentUz  String?
  guideContentRu  String?
  guideContentEn  String?
  // Declaration-vs-certificate comparison cards: 5 newline-separated
  // values each, matching 5 fixed rows whose labels are hardcoded in the
  // frontend (i18n) rather than stored here.
  comparisonDeclarationUz String?
  comparisonDeclarationRu String?
  comparisonDeclarationEn String?
  comparisonCertificateUz String?
  comparisonCertificateRu String?
  comparisonCertificateEn String?
  // FAQ: blank-line separated Q/A blocks, first line of each block is the
  // question, the rest is the answer.
  faqUz           String?
  faqRu           String?
  faqEn           String?
  updatedAt       DateTime @updatedAt
}

// Test Program Builder: admins assemble a per-product accreditation-scope
// test program from a pool of TestIndicator rows, with some indicators
// conditional on a question/option (e.g. "Ishlaydigan kuchlanish?" -> 220V
// vs 380V pulls in different indicators). Public users answer the
// questions on the product page and get back the resolved indicator list,
// downloadable as a .docx.
model TestIndicator {
  id           String   @id @default(uuid())
  nameUz       String
  nameRu       String
  nameEn       String
  // Position number in the official accreditation-scope registry (e.g.
  // "21"), distinct from the indicator's own database id.
  positionCode String?
  standardCode String?
  laboratoryId String?
  laboratory   Laboratory? @relation(fields: [laboratoryId], references: [id])
  method       String?
  unit         String?
  assignments  ProductIndicatorAssignment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
}

model Product {
  id            String   @id @default(uuid())
  slug          String   @unique
  nameUz        String
  nameRu        String
  nameEn        String
  laboratoryId  String
  laboratory    Laboratory @relation(fields: [laboratoryId], references: [id])
  descriptionUz String?
  questions     ProductQuestion[]
  indicators    ProductIndicatorAssignment[]
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
}

model ProductQuestion {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  questionUz  String
  questionRu  String
  questionEn  String
  order       Int      @default(0)
  options     ProductQuestionOption[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductQuestionOption {
  id          String   @id @default(uuid())
  questionId  String
  question    ProductQuestion @relation(fields: [questionId], references: [id])
  labelUz     String
  labelRu     String
  labelEn     String
  order       Int      @default(0)
  assignments ProductIndicatorAssignment[]
  createdAt   DateTime @default(now())
}

// conditionOptionId = null means the indicator is "asosiy" (baseline) and
// is always included in the generated program; otherwise it is only
// included when the linked option is among the caller's selectedOptions.
model ProductIndicatorAssignment {
  id                String   @id @default(uuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  indicatorId       String
  indicator         TestIndicator @relation(fields: [indicatorId], references: [id])
  conditionOptionId String?
  conditionOption   ProductQuestionOption? @relation(fields: [conditionOptionId], references: [id])
  // Display order within its group (baseline, or the assignments under one
  // option) — admin-editable via drag-and-drop in the constructor.
  order             Int      @default(0)
  createdAt         DateTime @default(now())
}

// ===== SMK (Sifat Menejmenti Kompleksi, ISO/IEC 17025) — FAZA 1 =====
// Muammo boshqaruvi: nomuvofiqliklar/CAPA va rasmiy sifat shikoyatlari.
// Qolgan 18 modul keyingi fazalarda shu bo'limga qo'shiladi.

enum NonConformanceSource {
  AUDIT
  SHIKOYAT
  ICHKI_KUZATUV
  NAMUNA_MUAMMOSI
}

enum NonConformanceStatus {
  OCHIQ
  JARAYONDA
  YOPILDI
  TASDIQLANDI
}

// code avtomatik "NC-<yil>-<tartib>" shaklida generatsiya qilinadi (backend
// crudFactory buildData orqali, adminRoutes.js'da).
model NonConformance {
  id                String               @id @default(uuid())
  laboratoryId String?
  laboratory   Laboratory? @relation(fields: [laboratoryId], references: [id])
  code              String               @unique
  source            NonConformanceSource
  description       String
  detectedDate      DateTime
  responsibleUserId String?
  responsibleUser   User?                @relation(fields: [responsibleUserId], references: [id])
  rootCauseAnalysis String?
  correctiveAction  String?
  dueDate           DateTime?
  closedDate        DateTime?
  status            NonConformanceStatus @default(OCHIQ)
  auditFindings     AuditFinding[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([laboratoryId])
}

enum ComplaintStatus {
  QABUL_QILINDI
  TEKSHIRILMOQDA
  HAL_QILINDI
}

// Rasmiy ISO shikoyat protsedurasi — mavjud ContactMessage'dan farqli:
// ContactMessage umumiy murojaatlar uchun, bu esa rasmiy tekshiruv/yechim
// jarayoni kuzatib boriladigan sifat shikoyatlari uchun. code avtomatik
// "SHK-<yil>-<tartib>" shaklida generatsiya qilinadi.
model Complaint {
  id                    String          @id @default(uuid())
  laboratoryId String?
  laboratory   Laboratory? @relation(fields: [laboratoryId], references: [id])
  code                  String          @unique
  fullName              String
  phone                 String?
  email                 String?
  relatedApplicationId  String?
  relatedApplication    Application?    @relation(fields: [relatedApplicationId], references: [id])
  description           String
  receivedDate          DateTime
  investigationNotes    String?
  resolution            String?
  responsibleUserId     String?
  responsibleUser       User?           @relation(fields: [responsibleUserId], references: [id])
  status                ComplaintStatus @default(QABUL_QILINDI)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([laboratoryId])
}

// ===== SMK — FAZA 2: Hujjat boshqaruvi =====

enum SMKDocumentCategory {
  PROTSEDURA
  KORSATMA
  FORMA
  JURNAL
}

enum SMKDocumentStatus {
  AMALDA
  QORALAMA
  BEKOR_QILINGAN
}

model SMKDocument {
  id          String              @id @default(uuid())
  laboratoryId String?
  laboratory   Laboratory? @relation(fields: [laboratoryId], references: [id])
  code        String              @unique
  titleUz     String
  titleRu     String
  titleEn     String
  category    SMKDocumentCategory
  ownerUserId String?
  ownerUser   User?               @relation(fields: [ownerUserId], references: [id])
  status      SMKDocumentStatus   @default(QORALAMA)
  versions    SMKDocumentVersion[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([laboratoryId])
}

model SMKDocumentVersion {
  id                String    @id @default(uuid())
  laboratoryId String?
  laboratory   Laboratory? @relation(fields: [laboratoryId], references: [id])
  documentId        String
  document          SMKDocument @relation(fields: [documentId], references: [id])
  versionNumber     String
  fileUrl           String?
  changeDescription String?
  approvedByUserId  String?
  approvedByUser    User?     @relation(fields: [approvedByUserId], references: [id])
  approvedAt        DateTime?
  acknowledgments   DocumentAcknowledgment[]
  createdAt         DateTime  @default(now())

  @@index([laboratoryId])
}

// ===== SMK — FAZA 3: Auditlar =====

enum InternalAuditStatus {
  REJALASHTIRILGAN
  OTKAZILDI
  YAKUNLANDI
}

model InternalAudit {
  id            String              @id @default(uuid())
  plannedDate   DateTime
  actualDate    DateTime?
  laboratoryId  String?
  laboratory    Laboratory?         @relation(fields: [laboratoryId], references: [id])
  auditorUserId String?
  auditorUser   User?               @relation(fields: [auditorUserId], references: [id])
  status        InternalAuditStatus @default(REJALASHTIRILGAN)
  summary       String?
  findings      AuditFinding[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([laboratoryId])
}

enum AuditFindingSeverity {
  KATTA
  KICHIK
  KUZATUV
}

model AuditFinding {
  id                     String               @id @default(uuid())
  laboratoryId String?
  laboratory   Laboratory? @relation(fields: [laboratoryId], references: [id])
  auditId                String
  audit                  InternalAudit        @relation(fields: [auditId], references: [id])
  description            String
  severity               AuditFindingSeverity
  linkedNonConformanceId String?
  linkedNonConformance   NonConformance?      @relation(fields: [linkedNonConformanceId], references: [id])
  createdAt              DateTime             @default(now())

  @@index([laboratoryId])
}

