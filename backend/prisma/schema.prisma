// ===== SMK — FAZA 6: Strategik =====

model ManagementReview {
  id             String    @id @default(uuid())
  laboratoryId String?
  laboratory   Laboratory? @relation(fields: [laboratoryId], references: [id])
  reviewDate     DateTime
  participants   String?
  agendaItems    String?
  decisions      String?
  nextReviewDate DateTime?
  createdAt      DateTime  @default(now())

  @@index([laboratoryId])
}

enum RiskStatus {
  FAOL
  NAZORAT_OSTIDA
  YOPILDI
}

// riskScore = likelihood * impact, backend tomonidan avtomatik hisoblanadi
// (adminRoutes.js'dagi buildData orqali) — admin qo'lda kiritmaydi.
model RiskItem {
  id             String     @id @default(uuid())
  laboratoryId String?
  laboratory   Laboratory? @relation(fields: [laboratoryId], references: [id])
  description    String
  category       String?
  likelihood     Int
  impact         Int
  riskScore      Int
  mitigationPlan String?
  ownerUserId    String?
  ownerUser      User?      @relation(fields: [ownerUserId], references: [id])
  status         RiskStatus @default(FAOL)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([laboratoryId])
}

enum QualityObjectiveStatus {
  BAJARILMOQDA
  BAJARILDI
  BAJARILMADI
}

model QualityObjective {
  id            String                  @id @default(uuid())
  laboratoryId String?
  laboratory   Laboratory? @relation(fields: [laboratoryId], references: [id])
  year          Int
  objectiveText String
  targetValue   String?
  actualValue   String?
