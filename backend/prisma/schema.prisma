  laboratoryId String?
  laboratory   Laboratory? @relation(fields: [laboratoryId], references: [id])
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  trainingTitle   String
  trainingDate    DateTime
  provider        String?
  certificateUrl  String?
  expiryDate      DateTime?
