  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([laboratoryId])
}

enum ImprovementSuggestionStatus {
  KORIB_CHIQILMOQDA
  QABUL_QILINDI
  RAD_ETILDI
}

model ImprovementSuggestion {
